  "claims": [
    {
      "id": "C-01",
      "text": "駅側の既存道路と新設道路を接続するため、地上交差点を改良する。",
      "classification": "Official plan",
      "scope": "2026-08 plan",
      "references": [
        {
          "source": "B1",
          "locator": "PDF p.21 / printed p.20"
        }
      ],
      "limits": "平面位置・線形の採用はGate 4待ち。"
    },
    {
      "id": "C-02",
      "text": "完成イメージに交通島、横断歩道、歩行者信号が描かれている。",
      "classification": "Official plan",
      "scope": "2026-08 illustration",
      "references": [
        {
          "source": "B1",
          "locator": "PDF pp.21,41 / printed pp.20,40"
        }
      ],
      "limits": "図記号は設置台数・灯器座標の確定資料ではない。"
    },
    {
      "id": "C-03",
      "text": "歩行者図は北側の横断経路と道路開通時の西側横断歩道を別工程として扱う。",
      "classification": "Official plan",
      "scope": "2026-08 scheduled stages",
      "references": [
        {
          "source": "B1",
          "locator": "PDF pp.38–41 / printed pp.37–40"
        }
      ],
      "limits": "9月中旬等の予定を11月3日の実施済み状況に読み替えない。"
    },
    {
      "id": "C-04",
      "text": "地下道出入口の一時封鎖と迂回を別途説明している。",
      "classification": "Official plan",
      "scope": "2026-08 scheduled stages",
      "references": [
        {
          "source": "B1",
          "locator": "PDF p.40 / printed p.39"
        }
      ],
      "limits": "車道アンダーパスと歩行者地下通路を混同しない。現在の開閉状態は未確認。"
    },
    {
      "id": "C-05",
      "text": "大型標識位置図は発注段階の図で、区画線等は最新と異なると注記されている。",
      "classification": "Observed",
      "scope": "document limitation",
      "references": [
        {
          "source": "B1",
          "locator": "PDF p.29 / printed p.28"
        }
      ],
      "limits": "当該図の矢印から最終右左折規制を決めない。"
    },
    {
      "id": "C-06",
      "text": "自転車専用通行帯・矢羽根型路面表示の整備方針が示されている。",
      "classification": "Official plan",
      "scope": "project-wide cycling",
      "references": [
        {
          "source": "B1",
          "locator": "PDF p.34 / printed p.33"
        },
        {
          "source": "B2",
          "locator": "Q2"
        }
      ],
      "limits": "交差点内の正確な自転車経路・規制は未確定。"
    },
    {
      "id": "C-07",
      "text": "2018年資料の5群は直進・左折、右折2方向、西側側道、東側側道、歩行者。",
      "classification": "Official plan",
      "scope": "historical-study-2018",
      "references": [
        {
          "source": "C3",
          "locator": "PDF p.3, bottom figure"
        }
      ],
      "limits": "将来協議・実運用による変更を明記。2026年最終現示ではない。"
    },
    {
      "id": "C-08",
      "text": "取得したOSMには本線のtunnel=yes/layer=-1と鉄道のlayer=1がある。",
      "classification": "Observed",
      "scope": "OSM snapshot only",
      "references": [
        {
          "source": "F4",
          "locator": "ways 124814741,124814742,161192972,854966477"
        },
        {
          "source": "F6",
          "locator": "definition"
        }
      ],
      "limits": "相対的な交差順序。鉄道＞全地上道路＞本線という一律の三層標高モデルは証明しない。"
    },
    {
      "id": "C-09",
      "text": "三ツ境下草柳線の公開事業計画の標準幅員は18m（4+10+4）。",
      "classification": "Official plan",
      "scope": "2024-10 plan published 2026-07",
      "references": [
        {
          "source": "A4",
          "locator": "PDF p.1"
        }
      ],
      "limits": "交差点局部の実幅員、全線開通、最終区画線を意味しない。"
    },
    {
      "id": "C-10",
      "text": "公開中の計画図の内部改定年月は2024年10月。第7回変更資料は今回未取得。",
      "classification": "Observed",
      "scope": "document currency",
      "references": [
        {
          "source": "A4",
          "locator": "PDF p.1 bottom-right"
        },
        {
          "source": "A6",
          "locator": "current page"
        }
      ],
      "limits": "2026というURL中の年月を設計改定年月としない。"
    },
    {
      "id": "C-11",
      "text": "現地の各流入方向の最終的な直進・右左折可否、信号現示・秒数は未確定。",
      "classification": "Unknown",
      "scope": "2026 final operation",
      "references": [
        {
          "source": "B1",
          "locator": "PDF pp.21,29"
        },
        {
          "source": "C3",
          "locator": "PDF p.3"
        }
      ],
      "limits": "一次資料不足。全方向通行可とも禁止とも推定しない。"
    },
    {
      "id": "C-12",
      "text": "2026年資料では三ツ境下草柳線中間部の横断歩道は設置予定なしと回答。",
      "classification": "Official plan",
      "scope": "2026-08 Q&A",
      "references": [
        {
          "source": "B2",
          "locator": "Q4"
        }
      ],
      "limits": "2017/2018年の中間部信号付き横断歩道検討を現行計画に移さない。"
    },
    {
      "id": "C-13",
      "text": "第24号では信号機・規制標識の設置を神奈川県警が実施すると記載。",
      "classification": "Official plan",
      "scope": "2026-03 work allocation",
      "references": [
        {
          "source": "C4",
          "locator": "PDF p.1"
        }
      ],
      "limits": "最終現示表の取得を意味しない。"
    },
    {
      "id": "C-14",
      "text": "地理院タイルの当該サンプルには計画新設道路の線形が描かれていない。",
      "classification": "Observed",
      "scope": "GSI retrieved map sample",
      "references": [
        {
          "source": "F5",
          "locator": "std z18 x232649–232651 y103414–103416"
        }
      ],
      "limits": "現地に道路がないという意味ではない。工事中の最新現況を保証しない。"
    },
    {
      "id": "C-15",
      "text": "対象地点の平面図に地上道路の曲がり、歩行者専用道路の表示、階段、鉄道の表示を確認。",
      "classification": "Observed",
      "scope": "road-ledger visual inspection, survey date unknown",
      "references": [
        {
          "source": "E10",
          "locator": "mid=67, plan layer 200, two view centres in docs/road-ledger-review.md"
        }
      ],
      "limits": "現行の施工済み状態や規制、座標・幅員の精度を確定しない。"
    },
    {
      "id": "C-16",
      "text": "市は台帳作成後の現況変更の可能性と、画面から現況幅員を確認できないことを説明。",
      "classification": "Observed",
      "scope": "official map interpretation limits",
      "references": [
        {
          "source": "E11",
          "locator": "sections 2,3,6,7"
        }
      ],
      "limits": "表示縮尺1/500だけで測量精度を与えない。"
    }
  ]
}
